LLM_PROVIDER=groq
LLM_API_KEY=
# Copiar la URL exacta indicada por el proveedor de la clave.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
PORT=3000
MAX_ITERATIONS=25
MAX_SESSION_TOKENS=150000
MAX_DAILY_TOKENS=1000000
LLM_TIMEOUT_MS=45000
# local para demo.ts; supabase para el despliegue público.
STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secreto exclusivo del backend, restringido a la fila del reto (no es service_role).
STORAGE_ACCESS_TOKEN=
