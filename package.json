{
  "name": "contratos-periferia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "build": "tsc",
    "check": "tsc --noEmit",
    "demo": "tsx demo.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "express": "^4.21.2",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "prettier": "^3.9.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
